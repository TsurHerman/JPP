# intrinsics.jpp — the target as a value. arch tags are comptime type
# values; ARCH is the tag of the current compilation target.

export ARCH, arm64, x86_64, wasm32, riscv64

type arm64
type x86_64
type wasm32
type riscv64

ARCH::type = zig{
    switch (@import("builtin").target.cpu.arch) {
        .aarch64 => arm64,
        .x86_64  => x86_64,
        .wasm32  => wasm32,
        .riscv64 => riscv64,
        else     => @compileError("jpp: unsupported target arch"),
    }
}
