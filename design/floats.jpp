# floats.jpp — machine floats: predicate, structure, promotion, ground ops.

export Float, bits, widen, promote
export +, -, *, fma, fast_inv_sqrt, convert

# --- predicate & structure ----------------------------------------------

Float(T::type) = false
for T in (float16, float32, float64) {
    Float(T) = true
}

widen(float16) = float32
widen(float32) = float64
widen(float64) = float64

# --- promote: wider wins -------------------------------------------------

promote{F<:Float, G<:Float} = bits(F) >= bits(G) ? F : G

# --- ground zero (IEEE 754) ----------------------------------------------

for T in (float16, float32, float64) {
    +(a::T, b::T)::T = zig{ a + b }
    -(a::T, b::T)::T = zig{ a - b }
    *(a::T, b::T)::T = zig{ a * b }
    bits(T)::int32 = zig{ @bitSizeOf(T) }   # per-T axiom, deliberately in-loop
}

using core
convert{T<:Float}(x<:Float)::T = zig{ @floatCast(x) }

# arch selection is ordinary dispatch on the comptime value ARCH
using intrinsics

fma(a::float64, b::float64, c::float64)::float64 = _fma(a, b, c, ARCH)

_fma(a, b, c, T::type)::float64 = zig{ @mulAdd(f64, a, b, c) }   # portable
_fma(a, b, c, ::arm64)::float64 = llvm{
    %r = call double @llvm.fma.f64(double %a, double %b, double %c)
    ret double %r
}

fast_inv_sqrt(x::float32)::float32 = c{
    float y = x;
    long i = *(long*)&y;
    i = 0x5f3759df - (i >> 1);
    y = *(float*)&i;
    return y * (1.5f - 0.5f * x * y * y);
}
