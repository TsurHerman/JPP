# core.jpp — the root: identity convert, tuple basics, variadic promote,
# and the calling convention itself.

export convert, promote, Tuple, len, first, beheaded, call

convert{T}(x::T) = x    # identity; exact match beats every predicate method

# --- tuple basics (comptime) ------------------------------------------------

Tuple(T::type) = zig{ jpp.isTuple(T) }

len{T} = 1                                  # any non-tuple comptime value
len{TT<:Tuple} = zig{ TT.len }
first{TT<:Tuple} = zig{ TT[0] }
beheaded{TT<:Tuple} where len{TT} == 1 = ()
beheaded{TT<:Tuple} = zig{ jpp.tail(TT) }   # comptime TT[1..]

# --- variadic promote ---------------------------------------------------------
# folds down to the binary promote{A,B} rules of the CALLER's context.
# len 2 is deliberately uncovered: the binary rules own it, and a missing
# rule errors there naming both types. covering 2 here would recurse forever.

promote{TT...} where len{TT} == 1 = first{TT}
promote{TT...} where len{TT} >= 3 =
    promote{first{TT}, promote{beheaded{TT}...}}

# --- the calling convention: the core of everything ---------------------------
# every surface call f(args...) in a module lowers to call{CONTEXT, f}.
# resolve{} is the single magical external — comptime over the context's
# method set, returning the one callable instance. everything else is library.

call{context, f}(args...) = resolve{context, f, typeof(args)}(args...)
