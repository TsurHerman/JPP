# ints.jpp — machine integers: predicates, structure, promotion, ground ops.

export Integer, Signed, Unsigned, bits, signed, unsigned, widen, promote
export +, -, *, popcount, convert

# --- predicates --------------------------------------------------------

Integer(T::type) = false
Signed(T::type)  = false

for T in (int8, int16, int32, int64) {
    Integer(T) = true
    Signed(T)  = true
}

for T in (uint8, uint16, uint32, uint64) {
    Integer(T) = true
}

Unsigned(T::type) = Integer(T) && !Signed(T)

# --- structure ---------------------------------------------------------

# signedness twins
for (U, S) in ((uint8,int8), (uint16,int16), (uint32,int32), (uint64,int64)) {
    signed(U)   = S
    signed(S)   = S
    unsigned(U) = U
    unsigned(S) = U
}

widen(int8)  = int16;  widen(int16)  = int32;  widen(int32)  = int64
widen(uint8) = uint16; widen(uint16) = uint32; widen(uint32) = uint64
widen(int64)  = int64      # top of the ladder; bigint is a module, not a builtin
widen(uint64) = uint64

# --- promote -----------------------------------------------------------

# same signedness: wider wins
promote{A<:Integer, B<:Integer} where Signed(A) == Signed(B) =
    bits(A) >= bits(B) ? A : B

# mixed signedness, julia verbatim: int32 + uint64 -> uint64
promote{S<:Signed, U<:Unsigned} = bits(S) > bits(U) ? S : U
promote{U<:Unsigned, S<:Signed} = promote{S, U}

# --- ground zero (wrapping arithmetic, julia semantics) -----------------

for T in (int8, int16, int32, int64, uint8, uint16, uint32, uint64) {
    +(a::T, b::T)::T = zig{ a +% b }
    -(a::T, b::T)::T = zig{ a -% b }
    *(a::T, b::T)::T = zig{ a *% b }
    popcount(a::T)::int32 = zig{ @popCount(a) }
    bits(T)::int32 = zig{ @bitSizeOf(T) }   # per-T axiom, deliberately in-loop
}

# int -> int, EXACT in all tiers: semantics are tier-invariant, so the
# check is explicit — never inherited from zig's build mode.
convert{T<:Integer}(x<:Integer)::T = zig{
    std.math.cast(T, x) orelse @panic("jpp: inexact")
}
