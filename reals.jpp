# reals.jpp — where ints and floats MEET. only the cross-domain methods
# live here; each family owns its in-family conversion, core owns identity.

using core
using ints
using floats

export Real, convert

Real(T::type) = Integer(T) || Float(T)

# int -> float: exact in the float's sense (rounds per IEEE)
convert(T::Float, x<:Integer)::T = zig{ @floatFromInt(x) }

# float -> int: julia-9/10, EXACT — InexactError unless representable
convert(T::Integer, x<:Float)::T = zig{
    const r = @round(x);
    if (r != x) @panic("inexact");
    @intFromFloat(r)
}
