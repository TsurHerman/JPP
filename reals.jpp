# reals.jpp — where ints and floats meet. convert lives here.

using ints
using floats

export Real, convert

Real(T::type) = Integer(T) || Float(T)

# convert(T, x): first argument is a type VALUE — ordinary dispatch.
convert(T::type, x::T) = x                      # identity, most specific

# julia-9/10: convert is EXACT — lossy conversion is an error, not a wrap.
# zig's casts agree in safe builds (@intCast asserts fit), so ground = zig.

convert(T::Integer, x::I) where Integer(I) && T != I = zig{ @intCast(x) }
convert(T::Float,   x::I) where Integer(I)           = zig{ @floatFromInt(x) }
convert(T::Float,   x::F) where Float(F) && T != F   = zig{ @floatCast(x) }
convert(T::Integer, x::F) where Float(F) = zig{
    // julia: InexactError unless representable. trap if fractional.
    const r = @round(x);
    if (r != x) @panic("inexact");
    @intFromFloat(r)
}
