# demo.jpp — two contexts, same expression, different meaning. legally.

module strict {
    using ints
    # no promotion policy imported.
    f() = int32(1) + int64(2)
    #     ^ compile error HERE (not at import, not globally):
    #     no method +(int32, int64) in context [strict, ints]
}

module easy {
    using ints
    using promote
    f() = int32(1) + int64(2)      # -> int64(3)
    g() = uint64(1) + int64(2)     # -> uint64(3), julia's rule verbatim
}

module paranoid {
    using ints
    using strict_promote           # the OTHER policy: mixed same-size
    h() = uint64(1) + int64(2)     # signedness is a compile error here.
                                   # rigor is a context, not a fork.
}

# the julia pain this kills: `easy` importing promote changed NOTHING
# for `strict`, for `ints`, for anyone. no invalidation wave. strict's
# compiled instances are byte-identical before and after easy exists.
