# promote.jpp
#
# promotion is not in the language and not in ints/floats/reals.
# it is a POLICY module: importing it is what makes `int32 + int64` legal.
# your context, your arithmetic. don't import it and mixed ops don't exist.

using reals

export promote, promotable, +, -, *

# --- the rule table: methods of `promote` ON TYPE VALUES ---------------
# (same open function as the value-level promote below; types are values,
#  dispatch tells them apart. julia's promote_type/promote pair collapsed.)

# same signedness: wider wins
promote(A::Integer, B::Integer) where Signed(A) == Signed(B) =
    bits(A) >= bits(B) ? A : B

# mixed signedness: julia's rule, verbatim (julia-9/10 principle).
# signed strictly wider than unsigned -> signed; otherwise unsigned.
promote(S::Signed, U::Unsigned) = bits(S) > bits(U) ? S : unsigned(S)
promote(U::Unsigned, S::Signed) = promote(S, U)

# ints dissolve into floats; floats: wider wins
promote(A::Integer, F::Float) = F
promote(F::Float, A::Integer) = F
promote(F::Float, G::Float) = bits(F) >= bits(G) ? F : G

# --- the reflection primitive ------------------------------------------
# exists(f, args...) : does f resolve for these comptime-known values,
# in this context? method-set reflection, memoized, cycle-answers-false.

promotable(A::type, B::type) = A != B && exists(promote, A, B)

# --- value-level promote, and the surface operators --------------------
# {A,B} = comptime type parameters, inferred from the arguments.
# extension-only rule keeps this from eating the world: we cannot
# re-cover +(int64,int64) — same-type arithmetic stays owned by ints.

promote{A,B}(a::A, b::B) where promotable(A, B) = {
    T = promote(A, B)                        # comptime, memoized
    (convert(T, a), convert(T, b))
}

+{A,B}(a::A, b::B) where promotable(A, B) = { (x, y) = promote(a, b); x + y }
-{A,B}(a::A, b::B) where promotable(A, B) = { (x, y) = promote(a, b); x - y }
*{A,B}(a::A, b::B) where promotable(A, B) = { (x, y) = promote(a, b); x * y }

# note: the A != B inside promotable is also what keeps exists(promote,A,B)
# well-founded — the value-level method can never satisfy its own existence
# check (for type-valued args A == B == type kills the guard). the guard
# does double duty: semantics and termination, same clause.
