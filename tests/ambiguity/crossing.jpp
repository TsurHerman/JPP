using Base.Any

# one module, two crossing generals: (exact, Any) and (Any, exact).
# chooseRule(1, 2) matches both and neither dominates — same module, so the
# promise is a comptime ERROR at the call, naming the cure.
export chooseRule

chooseRule(::int64, <:Any) = 1
chooseRule(<:Any, ::int64) = 2
