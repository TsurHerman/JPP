using Base.Any
export Signed, Wide, pick

Signed(T::type)::bool = zig{
    switch (@typeInfo(T)) {
        .int => |i| i.signedness == .signed,
        else => false,
    }
}

Wide(T::type)::bool = zig{
    switch (@typeInfo(T)) {
        .int => |i| i.bits >= 32,
        else => false,
    }
}

pick(<:Signed, ::int64) = 1
pick(<:Wide, <:Any) = 2

main() = pick(1, 2)
