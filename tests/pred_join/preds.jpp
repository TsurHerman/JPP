# `||` and `&&` are ordinary words — overridable, exported, dispatched
# like any other. the infix spelling is only surface: `a || b` parses
# to a call of the word `||`, exactly as `a + b` already did.
export Signed, Unsigned, Small, Integer, SmallSigned, Prec, ||, &&

||(a::bool, b::bool)::bool = zig{ a or b }

&&(a::bool, b::bool)::bool = zig{ a and b }

Signed(T::type)::bool = zig{
    switch (@typeInfo(T)) {
        .int => |i| i.signedness == .signed,
        else => false,
    }
}

Unsigned(T::type)::bool = zig{
    switch (@typeInfo(T)) {
        .int => |i| i.signedness == .unsigned,
        else => false,
    }
}

Small(T::type)::bool = zig{
    switch (@typeInfo(T)) {
        .int => |i| i.bits <= 16,
        else => false,
    }
}

# a JOIN and a MEET, both DEFINED rather than restated. this is the
# shape of `Triangular(T) = Upper(T) || Lower(T)`.
Integer(T::type)::bool = Signed(T) || Unsigned(T)

SmallSigned(T::type)::bool = Signed(T) && Small(T)

# precedence probe: `&&` binds tighter than `||`, so on an unsigned
# type this is (F && T) || T = true. the other reading, F && (T || T),
# is false — the two spellings disagree on every unsigned type.
Prec(T::type)::bool = Signed(T) && Unsigned(T) || Unsigned(T)
