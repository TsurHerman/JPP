# two gated methods on the SAME rung, in the SHORT slot spelling.
# `x<:Wide` is sugar for `x::T where Wide(T)` with T fresh, so these
# rank exactly as the long form does. int64 answers both predicates, so
# nothing but the declared order can separate them.
using preds
export category

category(<:Wide) = 1
category(<:Signed) = 2
