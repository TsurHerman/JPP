using Base
using Base.Zig

Level = Zig.std.log.Level

needsAttention(level::Level) = isOneOf(level, Level.err, Level.warn)

needsInvestigation(level::Level) = isOneOf(level, Level.err, Level.debug)

label(level::Level) where needsAttention(level) = "ATTENTION"
label(level::Level) where needsInvestigation(level) = "INVESTIGATE"
label(::Level) = "NORMAL"

# Errors match two predicates with no authored precedence.
main() = label(Level.err)
