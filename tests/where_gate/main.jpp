using Base.Any

# VALIDATES: `where T <: Integer` is a predicate gate on qualification,
# carried as method data, and a gated binder sits on the PREDICATE rung —
# so exact still beats it. Any is also a predicate; its authored order
# makes it the fallback. Note this file never
# imports `preds`: a library's gate resolves through the library's own
# static context, so gates do not leak a requirement onto callers.
using rules
using Base.Test

main() = {
    check("exact outranks the gate", describe(1), 3)
    check("authored order refines Any", describe(1.5), 2)
    check("Any is the fallback", describe("hi"), 0)

    check("gate selects: integer", kindof(1), 1)
    check("gate selects: float", kindof(1.5), 2)
    check("gate rejects: neither", kindof("hi"), 0)

    check("gate and identity together", pairup(1, 2), 1)
    check("identity fails, gate moot", pairup(1, 1.5), 0)
    check("identity holds, gate fails", pairup(1.5, 2.5), 0)

    # the short spelling answers the long spelling's ladder, rung for rung
    check("short form: exact still outranks", terse(1), 3)
    check("short form: authored order still refines Any", terse(1.5), 2)
    check("short form: Any is still the fallback", terse("hi"), 0)
}
