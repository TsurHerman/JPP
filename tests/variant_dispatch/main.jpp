using Base
export shipmentType, Express, Standard, Shipment, <:

shipmentType()::type = zig{
    union(enum) {
        express: i64,
        standard: i64,
    }
}

shipment(S::type, express::bool)::S = zig{
    if (express) .{ .express = 7 } else .{ .standard = 9 }
}

Express(T::type) = isExpress(T, shipmentType())

Standard(T::type) = isStandard(T, shipmentType())

Shipment(T::type) = inFamily(T, shipmentType())

isExpress(T::type, Owner::type)::bool = zig{ jpp.isVariant(T, Owner, .express) }

isStandard(T::type, Owner::type)::bool = zig{ jpp.isVariant(T, Owner, .standard) }

inFamily(T::type, Owner::type)::bool = zig{ jpp.isVariantOf(T, Owner) }


<:(Express, Shipment) = true
<:(Standard, Shipment) = true

identity(value) = value

basePrice(value<:Shipment) = value.payload

# Prices are cents. Only express delivery adds the 100-cent surcharge.
quote(value<:Shipment) = value.payload
quote(value<:Express) = value.payload + 100

forwardShipment(values...; options...) = addPackingFee(values...; options...)

addPackingFee(value<:Shipment; packing_cents) = basePrice(value) + packing_cents

knownExpress(S::type) = zig{
    .{ .value = S{ .express = 17 } }
}

selectedType(<:Express) = int64
selectedType(<:Standard) = float64

expressPrice(value<:Express) = value.payload

counter()::type = zig{
    struct {
        pub var count: i64 = 0;
    }
}

produce(S::type, C::type)::S = zig{
    blk: {
        C.count += 1;
        break :blk .{ .express = 7 };
    }
}

count(C::type)::int64 = zig{ C.count }

main() = {
    check("variant identity rejoins the original union", basePrice(identity(shipment(shipmentType(), false))), 9)
    check("broad grouped method accepts both tags", basePrice(shipment(shipmentType(), false)), 9)
    check("express shipment adds its surcharge", quote(shipment(shipmentType(), true)), 107)
    check("standard shipment keeps its base price", quote(shipment(shipmentType(), false)), 9)
    check("named and rest forwarding preserves variant", forwardShipment(shipment(shipmentType(), false); packing_cents = 3), 12)
    check(
        "known tag selects a type without a runtime join",
        selectedType(knownExpress(shipmentType()).value),
        int64
    )
    check("static input needs only selected arm coverage", expressPrice(knownExpress(shipmentType()).value), 17)
    check("producer output arrives at selected method", quote(produce(shipmentType(), counter())), 107)
    check("producer runs once across all potential arms", count(counter()), 1)
}
