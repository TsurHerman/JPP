using lib
using Base

minimum()::int64 = zig{ std.math.minInt(i64) }

maximum()::int64 = zig{ std.math.maxInt(i64) }

main() = {
    check("Base integer addition", 2 + 3, 5)
    check("Base integer subtraction", 7 - 3, 4)
    check("Base integer multiplication", 6 * 7, 42)
    check("integer slash returns a floating quotient", 7 / 2, 3.5)
    check("integer div truncates", div(7, 2), 3)
    check("negative div truncates toward zero", div(0 - 7, 2), 0 - 3)
    check("Base float operations", (1.5 + 2.5) * 3.0 - 2.0, 10.0)
    check("Base float division", 7.0 / 2.0, 3.5)
    check("integer addition wraps", maximum() + 1, minimum())
    check("integer subtraction wraps", minimum() - 1, maximum())
    check("integer multiplication wraps", maximum() * 2, 0 - 2)
    check("a library explicitly imports Base", double(21), 42)
    check("inherited Base keeps ordinary caller priority over deeper imports", report(5), 10)
}
