using Base.Arithmetic
using model.line
using model.priced
using pricing.lines
export priceBasket

priceBasket(bag) = priceLines(bag...)
priceLines() = pricedCart(0, 0, 0)
priceLines(item<:Line, rest<:Line...) = {
    remaining = priceLines(rest...)
    pricedCart(grossLine(item) + grossGoods(remaining),
        netLine(item) + netGoods(remaining), gramsLine(item) + parcelGrams(remaining))
}
