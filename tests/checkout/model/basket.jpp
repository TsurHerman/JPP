using model.line
export basket, firstItem, secondItem

# Two lines make the current lack of variadic packs/iteration visible.
basket(a::T, b::T) where T <: Line = makeBasket(a, b)
makeBasket(a::T, b::T) where T = zig{ .{ .first = a, .second = b } }
firstItem(bag) = zig{ bag.first }
secondItem(bag) = zig{ bag.second }
