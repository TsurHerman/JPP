# Takeover module: this is the public shipping API, not an export-all folder.
using arithmetic
using shipping.carrier
export shippingCharge, freeShippingThreshold

freeShippingThreshold() = 10000
shippingCharge(net_cents::int64, grams::int64) = choose(isZero(grams), 0, choose(isZero(net_cents), 0, choose(atLeast(net_cents, freeShippingThreshold()), 0, carrierFee(grams))))
