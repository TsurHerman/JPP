using arithmetic
using model.priced
using model.quote
using pricing.cart
using shipping
using tax
export quote

quote(bag) = withPrices(priceBasket(bag))
withPrices(priced) = withShipping(priced, shippingCharge(netGoods(priced), parcelGrams(priced)))
withShipping(priced, freight::int64) = withTax(priced, freight, taxCharge(netGoods(priced), freight))
withTax(priced, freight::int64, tax_cents::int64) = quoteRecord(grossGoods(priced), grossGoods(priced) - netGoods(priced), netGoods(priced), freight, tax_cents, netGoods(priced) + freight + tax_cents)
