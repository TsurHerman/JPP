using model.priced
using model.quote
using pricing.cart
using shipping
using tax
export quote

quote(bag) = {
    priced = priceBasket(bag)
    gross = grossGoods(priced)
    net = netGoods(priced)
    freight = shippingCharge(net, parcelGrams(priced))
    tax_cents = taxCharge(net, freight)
    total = net + freight + tax_cents
    quoteRecord(gross, gross - net, net, freight, tax_cents, total)
}
