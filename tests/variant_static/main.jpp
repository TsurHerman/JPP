using Base

shipmentType()::type = zig{
    union(enum) {
        express: i64,
        standard: i64,
    }
}

known(S::type) = zig{
    .{ .value = S{ .express = 17 } }
}

runtime(S::type, express::bool)::S = zig{
    if (express) .{ .express = 7 } else .{ .standard = 9 }
}

payload(value) = value.payload

envelopeType(Inner::type)::type = zig{
    union(enum) { value: Inner, empty: void }
}

knownEnvelope(Outer::type, Inner::type) = zig{
    .{ .value = Outer{ .value = Inner{ .express = 23 } } }
}

Express(T::type) = expressOf(T, shipmentType())

expressOf(T::type, U::type)::bool = zig{ jpp.isVariant(T, U, .express) }

selectedType(<:Express) = int64

forward(values...; options...) = named(values...; options...)

named(; value) = payload(value)

second(<:Any, value) = value.payload

isStatic(pack)::bool = zig{ @typeInfo(@TypeOf(pack)).@"struct".fields[0].is_comptime }

counter()::type = zig{
    struct {
        pub var count: i64 = 0;
    }
}

tick(C::type)::nothing = zig{
    {
        C.count += 1;
    }
}

count(C::type)::int64 = zig{ C.count }

withEffect(value, C::type) = {
    tick(C)
    value.payload
}

main() = {
    source = known(shipmentType())
    result = payload(source.value)
    check("known arm returns its payload", result, 17)
    check("known payload survives a helper call", isStatic((result,)), true)
    forwarded = forward(; value = source.value)
    check("known payload survives named and rest forwarding", isStatic((forwarded,)), true)
    check("forwarded payload keeps its value", forwarded, 17)
    effected = withEffect(source.value, counter())
    check("static result still executes the body once", count(counter()), 1)
    check("effectful helper retains the known result", isStatic((effected,)), true)
    check("effectful helper returns its payload", effected, 17)
    inner = payload(knownEnvelope(envelopeType(shipmentType()), shipmentType()).value)
    check("returned known tag needs only its selected method", selectedType(inner), int64)
    check("nested known union keeps its payload", payload(inner), 23)
    check("nested known payload remains static", isStatic((payload(inner),)), true)
    dynamic = payload(runtime(shipmentType(), true))
    check("runtime arm keeps its payload as data", isStatic((dynamic,)), false)
    check("runtime express payload is correct", dynamic, 7)
    check("runtime standard payload is correct", payload(runtime(shipmentType(), false)), 9)
    mixed = second(source.value, runtime(shipmentType(), false))
    check("a known coordinate does not freeze another coordinate", isStatic((mixed,)), false)
    check("mixed static and runtime coordinates keep the runtime value", mixed, 9)
}
