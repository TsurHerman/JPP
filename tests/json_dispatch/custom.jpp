using policy.masked
using policy.numbers
using suite
using model
main() = {
    # Same imported suite, two writer types in this caller context.
    expectDocument(Plain, "[17,\"x\",{\"name\":\"Ada\",\"n\":2}]", "[17,\"x\",{\"name\":\"Ada\",\"n\":2}]")
    expectDocument(Masked, "[17,\"x\",{\"name\":\"Ada\",\"n\":2}]", "[\"17\",\"[redacted]\",{\"name\":\"[redacted]\",\"n\":\"2\"}]")
    expectDocument(Masked, "[true,null,1.25,123456789012345678901234567890]", "[true,null,1.25,123456789012345678901234567890]")
    checkFailure()
}
