{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "JPP",
  "scopeName": "source.jpp",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#import"
    },
    {
      "include": "#export"
    },
    {
      "include": "#method"
    },
    {
      "include": "#module-binding"
    },
    {
      "include": "#expression"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.jpp",
      "begin": "#",
      "end": "$"
    },
    "string": {
      "name": "string.quoted.double.jpp",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.jpp"
        }
      ]
    },
    "ground": {
      "begin": "\\b(zig)(\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.ground.jpp"
        },
        "2": {
          "name": "punctuation.section.embedded.begin.jpp"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.jpp"
        }
      },
      "contentName": "meta.embedded.block.zig",
      "patterns": [
        {
          "include": "#zig-content"
        }
      ]
    },
    "zig-content": {
      "patterns": [
        {
          "include": "#zig-braces"
        },
        {
          "include": "source.zig"
        },
        {
          "include": "#zig-fallback"
        }
      ]
    },
    "zig-braces": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.block.begin.zig"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.zig"
        }
      },
      "patterns": [
        {
          "include": "#zig-content"
        }
      ]
    },
    "zig-fallback": {
      "comment": "Basic Zig colors when no source.zig grammar is installed; keep strings/comments opaque to brace matching.",
      "patterns": [
        {
          "begin": "//",
          "end": "$",
          "name": "comment.line.double-slash.zig"
        },
        {
          "match": "\\\\\\\\.*$",
          "name": "string.quoted.multiline.zig"
        },
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.zig",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.zig"
            }
          ]
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.zig",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.zig"
            }
          ]
        },
        {
          "match": "@[A-Za-z_][A-Za-z_0-9]*",
          "name": "support.function.builtin.zig"
        },
        {
          "match": "\\b(?:addrspace|align|allowzero|and|anyframe|anytype|asm|async|await|break|callconv|catch|comptime|const|continue|defer|else|enum|errdefer|error|export|extern|fn|for|if|inline|linksection|noalias|noinline|nosuspend|opaque|or|orelse|packed|pub|resume|return|section|struct|suspend|switch|test|threadlocal|try|union|unreachable|usingnamespace|var|volatile|while)\\b",
          "name": "keyword.control.zig"
        },
        {
          "match": "\\b(?:[iu][0-9]+|f(?:16|32|64|80|128)|[iu]size|bool|void|noreturn|type|anyerror|anyopaque|comptime_int|comptime_float)\\b",
          "name": "storage.type.zig"
        },
        {
          "match": "\\b(?:true|false|null|undefined)\\b",
          "name": "constant.language.zig"
        },
        {
          "match": "\\b[0-9][A-Za-z_0-9]*(?:\\.[A-Za-z_0-9]+)?\\b",
          "name": "constant.numeric.zig"
        },
        {
          "match": "[+*/%=!<>&|?:~^\\-]+",
          "name": "keyword.operator.zig"
        }
      ]
    },
    "import": {
      "match": "\\b(using)\\b[ \\t]+([A-Za-z_][A-Za-z_0-9]*(?:\\.[A-Za-z_][A-Za-z_0-9]*)*(?:\\.\\*)?)",
      "captures": {
        "1": {
          "name": "keyword.control.import.jpp"
        },
        "2": {
          "name": "entity.name.namespace.jpp"
        }
      }
    },
    "export": {
      "begin": "\\bexport\\b",
      "beginCaptures": {
        "0": {
          "name": "keyword.control.export.jpp"
        }
      },
      "end": "(?=;|#)|$",
      "patterns": [
        {
          "match": "(?:[A-Za-z_][A-Za-z_0-9]*|<:|==|&&|\\|\\||[+*/<>\\-])",
          "name": "entity.name.function.export.jpp"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "method": {
      "comment": "Recognize declaration-shaped lines; call expressions have their own nested context. No name lookup or capitalization assumptions.",
      "begin": "(?:^|(?<=;))[ \\t]*((?:[A-Za-z_][A-Za-z_0-9]*|<:|==|&&|\\|\\||[+*/<>\\-]))([ \\t]*)(\\()(?=[^()#]*\\)[ \\t]*(?:::|where\\b|=(?!=))|[^()]*$)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.definition.jpp"
        },
        "3": {
          "name": "punctuation.section.parameters.begin.jpp"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.parameters.end.jpp"
        }
      },
      "name": "meta.method.signature.jpp",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#annotation"
        },
        {
          "include": "#case-pattern"
        },
        {
          "include": "#builtin-type"
        },
        {
          "match": "\\b_\\b",
          "name": "variable.language.anonymous.jpp"
        },
        {
          "match": "\\b[A-Za-z_][A-Za-z_0-9]*\\b",
          "name": "variable.parameter.jpp"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "case-pattern": {
      "match": "\\b[A-Za-z_][A-Za-z_0-9]*(?:\\.[A-Za-z_][A-Za-z_0-9]*)+",
      "name": "constant.other.enum.jpp"
    },
    "where": {
      "begin": "\\bwhere\\b",
      "beginCaptures": {
        "0": {
          "name": "keyword.control.where.jpp"
        }
      },
      "end": "(?=(?<![=])=(?!=))",
      "name": "meta.guard.jpp",
      "patterns": [
        {
          "include": "#expression"
        }
      ]
    },
    "annotation": {
      "patterns": [
        {
          "match": "(::)[ \\t]*([A-Za-z_][A-Za-z_0-9]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.annotation.type.jpp"
            },
            "2": {
              "name": "entity.name.type.jpp"
            }
          }
        },
        {
          "match": "(<:)[ \\t]*([A-Za-z_][A-Za-z_0-9]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.annotation.predicate.jpp"
            },
            "2": {
              "name": "entity.name.type.predicate.jpp"
            }
          }
        }
      ]
    },
    "builtin-type": {
      "match": "\\b(?:u?int(?:8|16|32|64)|float(?:32|64)|bool|nothing|string|type)\\b",
      "name": "support.type.jpp"
    },
    "module-binding": {
      "match": "(?:^|(?<=;))[ \\t]*([A-Za-z_][A-Za-z_0-9]*)(?=[ \\t]*=(?!=))",
      "name": "variable.other.constant.module.jpp"
    },
    "local-binding": {
      "match": "\\b[A-Za-z_][A-Za-z_0-9]*(?=[ \\t]*=(?!=))",
      "name": "variable.other.constant.local.jpp"
    },
    "block": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.block.begin.jpp"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.jpp"
        }
      },
      "patterns": [
        {
          "include": "#local-binding"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "call": {
      "begin": "\\b([A-Za-z_][A-Za-z_0-9]*)([ \\t]*)(\\()",
      "end": "\\)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.call.jpp"
        },
        "3": {
          "name": "punctuation.section.arguments.begin.jpp"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.arguments.end.jpp"
        }
      },
      "patterns": [
        {
          "include": "#named-section"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "pack": {
      "begin": "\\(",
      "end": "\\)",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.pack.begin.jpp"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.pack.end.jpp"
        }
      },
      "patterns": [
        {
          "include": "#named-section"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "named-section": {
      "begin": ";",
      "end": "(?=\\))",
      "beginCaptures": {
        "0": {
          "name": "punctuation.separator.named.jpp"
        }
      },
      "patterns": [
        {
          "match": "\\b[A-Za-z_][A-Za-z_0-9]*(?=[ \\t]*=(?!=))",
          "name": "variable.other.property.named.jpp"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "projection": {
      "match": "(?<!\\.)(\\.)([A-Za-z_][A-Za-z_0-9]*|[0-9]+)",
      "captures": {
        "1": {
          "name": "punctuation.accessor.jpp"
        },
        "2": {
          "name": "variable.other.property.jpp"
        }
      }
    },
    "operators": {
      "patterns": [
        {
          "match": "\\.\\.\\.",
          "name": "keyword.operator.spread.jpp"
        },
        {
          "match": "::",
          "name": "keyword.operator.annotation.type.jpp"
        },
        {
          "match": "<:",
          "name": "keyword.operator.annotation.predicate.jpp"
        },
        {
          "match": "==|[<>]",
          "name": "keyword.operator.comparison.jpp"
        },
        {
          "match": "&&|\\|\\|",
          "name": "keyword.operator.logical.jpp"
        },
        {
          "match": "[+*/\\-]",
          "name": "keyword.operator.arithmetic.jpp"
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.jpp"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": ";",
          "name": "punctuation.separator.named.jpp"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.jpp"
        }
      ]
    },
    "expression": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#string"
        },
        {
          "include": "#ground"
        },
        {
          "include": "#where"
        },
        {
          "include": "#annotation"
        },
        {
          "include": "#builtin-type"
        },
        {
          "match": "\\b(true|false)\\b",
          "name": "constant.language.boolean.jpp"
        },
        {
          "match": "\\b(do|bindword)\\b",
          "name": "keyword.control.callable.jpp"
        },
        {
          "include": "#call"
        },
        {
          "include": "#pack"
        },
        {
          "include": "#block"
        },
        {
          "include": "#projection"
        },
        {
          "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b",
          "name": "constant.numeric.jpp"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        },
        {
          "match": "\\b_\\b",
          "name": "variable.language.anonymous.jpp"
        },
        {
          "match": "\\b[A-Za-z_][A-Za-z_0-9]*\\b",
          "name": "variable.other.jpp"
        }
      ]
    }
  }
}
