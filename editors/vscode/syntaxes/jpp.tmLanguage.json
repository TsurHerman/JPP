{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "JPP",
  "scopeName": "source.jpp",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#ground" },
    {
      "match": "\\b(using)\\b[ \\t]+([A-Za-z_][A-Za-z_0-9]*(?:\\.[A-Za-z_][A-Za-z_0-9]*)*(?:\\.\\*)?)",
      "captures": {
        "1": { "name": "keyword.control.import.jpp" },
        "2": { "name": "entity.name.namespace.jpp" }
      }
    },
    { "match": "\\b(using|export|where)\\b", "name": "keyword.control.jpp" },
    { "match": "\\b(true|false)\\b", "name": "constant.language.boolean.jpp" },
    {
      "match": "(::|<:)[ \\t]*([A-Za-z_][A-Za-z_0-9]*)",
      "captures": {
        "1": { "name": "keyword.operator.annotation.jpp" },
        "2": { "name": "entity.name.type.jpp" }
      }
    },
    { "match": "\\b(?:u?int(?:8|16|32|64)|float(?:32|64)|bool|nothing|string|type)\\b", "name": "support.type.jpp" },
    { "match": "\\b[A-Za-z_][A-Za-z_0-9]*(?=[ \\t]*\\()", "name": "entity.name.function.jpp" },
    {
      "match": "(?<!\\.)(\\.)([A-Za-z_][A-Za-z_0-9]*|[0-9]+)",
      "captures": {
        "1": { "name": "punctuation.accessor.jpp" },
        "2": { "name": "variable.other.property.jpp" }
      }
    },
    { "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b", "name": "constant.numeric.jpp" },
    { "match": "\\.\\.\\.", "name": "keyword.operator.spread.jpp" },
    { "match": "::|<:|==|&&|\\|\\||[+*/=\\-]", "name": "keyword.operator.jpp" },
    { "match": "[(){}]", "name": "punctuation.section.jpp" },
    { "match": "[,;]", "name": "punctuation.separator.jpp" },
    { "match": "\\b[A-Za-z_][A-Za-z_0-9]*\\b", "name": "variable.other.jpp" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.jpp",
      "begin": "#",
      "end": "$"
    },
    "string": {
      "name": "string.quoted.double.jpp",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.jpp" }]
    },
    "ground": {
      "begin": "\\b(zig)(\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.control.ground.jpp" },
        "2": { "name": "punctuation.section.embedded.begin.jpp" }
      },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.jpp" } },
      "contentName": "meta.embedded.block.zig",
      "patterns": [{ "include": "#zig-content" }]
    },
    "zig-content": {
      "patterns": [
        { "include": "#zig-braces" },
        { "include": "source.zig" },
        { "include": "#zig-fallback" }
      ]
    },
    "zig-braces": {
      "begin": "\\{",
      "beginCaptures": { "0": { "name": "punctuation.section.block.begin.zig" } },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.section.block.end.zig" } },
      "patterns": [{ "include": "#zig-content" }]
    },
    "zig-fallback": {
      "comment": "Basic Zig colors when no source.zig grammar is installed; keep strings/comments opaque to brace matching.",
      "patterns": [
        { "begin": "//", "end": "$", "name": "comment.line.double-slash.zig" },
        { "match": "\\\\\\\\.*$", "name": "string.quoted.multiline.zig" },
        {
          "begin": "\"", "end": "\"", "name": "string.quoted.double.zig",
          "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.zig" }]
        },
        {
          "begin": "'", "end": "'", "name": "string.quoted.single.zig",
          "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.zig" }]
        },
        { "match": "@[A-Za-z_][A-Za-z_0-9]*", "name": "support.function.builtin.zig" },
        { "match": "\\b(?:addrspace|align|allowzero|and|anyframe|anytype|asm|async|await|break|callconv|catch|comptime|const|continue|defer|else|enum|errdefer|error|export|extern|fn|for|if|inline|linksection|noalias|noinline|nosuspend|opaque|or|orelse|packed|pub|resume|return|section|struct|suspend|switch|test|threadlocal|try|union|unreachable|usingnamespace|var|volatile|while)\\b", "name": "keyword.control.zig" },
        { "match": "\\b(?:[iu][0-9]+|f(?:16|32|64|80|128)|[iu]size|bool|void|noreturn|type|anyerror|anyopaque|comptime_int|comptime_float)\\b", "name": "storage.type.zig" },
        { "match": "\\b(?:true|false|null|undefined)\\b", "name": "constant.language.zig" },
        { "match": "\\b[0-9][A-Za-z_0-9]*(?:\\.[A-Za-z_0-9]+)?\\b", "name": "constant.numeric.zig" },
        { "match": "[+*/%=!<>&|?:~^\\-]+", "name": "keyword.operator.zig" }
      ]
    }
  }
}
